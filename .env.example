# Environment template for discord-bot-template.
#
# The bot reads real process environment variables only: there is no .env/dotenv
# loading and no deployment ids are compiled in. Export these values in your
# shell or configure them in your process manager before `cargo run --release`.
# See README.md -> Configuration for what each variable changes.

# Required. Bot token from
# https://discord.com/developers/applications -> your application -> Bot -> Token.
DISCORD_TOKEN=

# Required. Id of the guild (server) the bot runs in. Guild slash commands are
# registered there, so it must match the guild the bot actually runs in.
DISCORD_GUILD_ID=

# Required. Channel id where join/leave/kick/ban announcements are posted. The
# bot needs the View Audit Log permission to tell kicks and bans apart from
# genuine leaves.
DISCORD_LOG_CHANNEL_ID=

# Optional. User id mentioned as the creator in /info; the mention line is
# omitted when unset.
DISCORD_OWNER_ID=

# Optional. Application emoji id used as the /info GitHub link-button icon; no
# icon is shown when unset. It must be an emoji owned by this application.
DISCORD_GITHUB_EMOJI_ID=

# Optional. Invite URL (for example https://discord.gg/your-invite) added as an
# embed to /dashboard; the invite embed is omitted when unset. When set, it must
# be an http(s) URL.
DISCORD_INVITE_URL=
